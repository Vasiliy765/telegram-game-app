rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasDurakSeat(room, uid) {
      let seats = room.get('seats', {});
      return seats.get('0', {}).get('id', '') == uid ||
        seats.get('1', {}).get('id', '') == uid ||
        seats.get('2', {}).get('id', '') == uid ||
        seats.get('3', {}).get('id', '') == uid ||
        seats.get('4', {}).get('id', '') == uid ||
        seats.get('5', {}).get('id', '') == uid;
    }

    function validDurakJoin() {
      let oldMeta = resource.data.get('meta', {});
      let newMeta = request.resource.data.get('meta', {});
      let oldMembers = oldMeta.get('members', {});
      let newMembers = newMeta.get('members', {});
      let oldSeats = resource.data.get('seats', {});
      let newSeats = request.resource.data.get('seats', {});
      return oldMeta.get('status', '') == 'waiting' &&
        oldMembers.get(request.auth.uid, false) != true &&
        newMembers.get(request.auth.uid, false) == true &&
        newMembers.diff(oldMembers).affectedKeys().hasOnly([request.auth.uid]) &&
        !hasDurakSeat(resource.data, request.auth.uid) &&
        hasDurakSeat(request.resource.data, request.auth.uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meta', 'seats']) &&
        newMeta.diff(oldMeta).affectedKeys().hasOnly(['members', 'bank']) &&
        newMeta.get('bank', 0) == oldMeta.get('bank', 0) +
          oldMeta.get('settings', {}).get('stake', 0) &&
        newSeats.diff(oldSeats).affectedKeys().size() == 1 &&
        newSeats.keys().size() <= newMeta.get('settings', {}).get('players', 2);
    }

    function validShopProfile(profile) {
      let ownedSkins = profile.get('ownedSkins', ['classic-red']);
      let activeSkin = profile.get('activeSkin', 'classic-red');
      return ownedSkins is list &&
        ownedSkins.size() > 0 &&
        ownedSkins.size() <= 5 &&
        ownedSkins.toSet().hasOnly([
          'classic-red', 'neon', 'gold', 'spy', 'emerald'
        ]) &&
        ownedSkins.toSet().hasAll(['classic-red']) &&
        activeSkin is string &&
        ownedSkins.toSet().hasAny([activeSkin]) &&
        profile.get('vipUntil', 0) is int &&
        profile.get('vipUntil', 0) >= 0;
    }

    function validUserProfile() {
      let profile = request.resource.data;
      return profile.keys().hasOnly([
          'id', 'name', 'username', 'balance', 'telegramId', 'photoUrl', 'updatedAt',
          'diamonds', 'lastSalaryAt', 'ownedSkins', 'activeSkin', 'vipUntil'
        ]) &&
        (profile.get('id', 0) is int || profile.get('id', '') is string) &&
        profile.get('name', '') is string &&
        profile.get('username', '') is string &&
        (profile.get('balance', -1) is int || profile.get('balance', -1) is float) &&
        profile.get('balance', -1) >= 0 &&
        profile.get('telegramId', '') is string &&
        profile.get('photoUrl', '') is string &&
        profile.get('updatedAt', 0) is int &&
        profile.get('diamonds', 0) is int &&
        profile.get('diamonds', 0) >= 0 &&
        profile.get('lastSalaryAt', 0) is int &&
        profile.get('lastSalaryAt', 0) >= 0 &&
        validShopProfile(profile);
    }

    function validPlayerRoomJoin() {
      let oldPlayers = resource.data.get('players', {});
      let newPlayers = request.resource.data.get('players', {});
      let oldMeta = resource.data.get('meta', {});
      let newMeta = request.resource.data.get('meta', {});
      return oldMeta.get('status', '') == 'waiting' &&
        oldPlayers.get(request.auth.uid, {}).get('id', '') == '' &&
        newPlayers.get(request.auth.uid, {}).get('id', '') == request.auth.uid &&
        newPlayers.diff(oldPlayers).affectedKeys().hasOnly([request.auth.uid]) &&
        newMeta.diff(oldMeta).affectedKeys().hasOnly(['bank']) &&
        newMeta.get('bank', 0) == oldMeta.get('bank', 0) + oldMeta.get('stake', 0) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['meta', 'players']) &&
        newPlayers.keys().size() <= 2;
    }

    match /users/{telegramId} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() && validUserProfile();
      allow delete: if false;
    }

    match /players/{uid} {
      allow get, list: if signedIn();
      allow create, update: if signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.keys().hasOnly([
          'telegramId', 'username', 'name', 'photoUrl', 'balance', 'updatedAt'
        ]) &&
        request.resource.data.balance is int &&
        request.resource.data.balance >= 0 &&
        request.resource.data.updatedAt is int &&
        request.resource.data.telegramId is string &&
        request.resource.data.username is string &&
        request.resource.data.name is string &&
        request.resource.data.photoUrl is string;
      allow delete: if false;
    }

    match /durakRooms/{roomId} {
      allow get: if signedIn();
      allow list: if signedIn() &&
        resource.data.get('meta', {}).get('isPublic', false) == true &&
        resource.data.get('meta', {}).get('status', '') == 'waiting';
      allow create: if signedIn() &&
        request.resource.data.get('meta', {}).get('hostId', '') == request.auth.uid &&
        request.resource.data.get('meta', {}).get('members', {}).get(request.auth.uid, false) == true;
      allow update: if signedIn() &&
        (resource.data.get('meta', {}).get('hostId', '') == request.auth.uid ||
         resource.data.get('meta', {}).get('members', {}).get(request.auth.uid, false) == true ||
         validDurakJoin());
      allow delete: if signedIn() &&
        resource.data.get('meta', {}).get('hostId', '') == request.auth.uid;
    }

    match /tictactoeRooms/{roomId} {
      allow get: if signedIn();
      allow list: if signedIn() &&
        resource.data.get('meta', {}).get('isPublic', false) == true &&
        resource.data.get('meta', {}).get('status', '') == 'waiting';
      allow create: if signedIn() &&
        request.resource.data.get('meta', {}).get('hostId', '') == request.auth.uid &&
        request.resource.data.get('players', {}).get(request.auth.uid, {}).get('id', '') == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.get('meta', {}).get('hostId', '') == request.auth.uid ||
         resource.data.get('players', {}).get(request.auth.uid, {}).get('id', '') == request.auth.uid ||
         validPlayerRoomJoin());
      allow delete: if signedIn() &&
        resource.data.get('meta', {}).get('hostId', '') == request.auth.uid;
    }

    match /battleshipRooms/{roomId} {
      allow get: if signedIn();
      allow list: if signedIn() &&
        resource.data.get('meta', {}).get('isPublic', false) == true &&
        resource.data.get('meta', {}).get('status', '') == 'waiting';
      allow create: if signedIn() &&
        request.resource.data.get('meta', {}).get('hostId', '') == request.auth.uid &&
        request.resource.data.get('players', {}).get(request.auth.uid, {}).get('id', '') == request.auth.uid;
      allow update: if signedIn() &&
        (resource.data.get('meta', {}).get('hostId', '') == request.auth.uid ||
         resource.data.get('players', {}).get(request.auth.uid, {}).get('id', '') == request.auth.uid ||
         validPlayerRoomJoin());
      allow delete: if signedIn() &&
        resource.data.get('meta', {}).get('hostId', '') == request.auth.uid;
    }
  }
}
